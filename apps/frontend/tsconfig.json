{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@viewrpc": ["./../../backend/views/rpc.ts"],
      "@pizzadb": ["./../../backend/pizzadb/types/index.ts"],
      "@view": ["./../../backend/views/modules/types/index.ts"],
      "@types": ["./../../backend/shared/types/index.ts"]
    }
  },
  "include": ["src", "./../../backend/shared", "./../../backend/views"],
  "exclude": ["./src/lib/rpc/index.ts", "../../backend/**/*", "../backend/**/*"]
  // "references": [{ "path": "./tsconfig.node.json" }]
}
